# Required for vision API (ingredients + weights from food photo)
OPENAI_API_KEY=sk-...

# Optional: override paths (defaults are in ./data)
# PROMPT_PATH=./data/promt.txt
# NUTRITION_CSV_PATH=./data/nutrition.csv

# Semantic ingredient matching (downloads model from huggingface.co). Default false — use true only where HF is reachable.
# NUTRITION_ENABLE_SEMANTIC=false

# Telegram bot (required to run the bot)
# TELEGRAM_BOT_TOKEN=...

# Backend URL for the bot to call (default: http://127.0.0.1:8000)
# BASE_URL=http://127.0.0.1:8000

# Database (default: sqlite:///./meal_mentor.db)
# DATABASE_URL=sqlite:///./meal_mentor.db
